{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"]
    },
    "logs": {
        "text": "build/infection.txt",
        "summary": "build/infection-summary.txt",
        "github": true
    },
    "mutators": {
        "@default": true,
        "IncrementInteger": false,
        "DecrementInteger": false,
        "CastString": {
            "ignoreSourceCodeByRegex": [
                ".*json_encode.*"
            ]
        }
    },
    "testFramework": "pest",
    "minMsi": 75,
    "minCoveredMsi": 80
}
